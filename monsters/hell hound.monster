5 ft., one target. _Hit:_ 7 (1d8 + 3) piercing damage plus 7 (2d6) fire damage."},{"name":"Fire Breath (Recharge 5-6)","desc":"The hound exhales fire in a 15-foot cone. Each creature in that area must make a DC 12 Dexterity saving throw, taking 21 (6d6) fire damage on a failed save, or half as much damage on a successful one."}],"reactions":[],"legendaries":[],"lairs":[],"regionals":[],"sthrows":[],"skills":[{"name":"perception","stat":"wis","note":" (ex)"}],"damagetypes":[{"name":"fire","note":" (Immune)","type":"i"}],"specialdamage":[],"conditions":[],"languages":[{"name":"Infernal","speaks":false}],"understandsBut":"can't speak it","shortName":"","doubleColumns":false,"separationPoint":1,"damage":[]}