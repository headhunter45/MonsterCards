  "traits": [],
  "actions": [
    {
      "name": "Multiattack",
      "desc": "Sirrith makes two melee attacks with her Petrified Ash Staff, or makes one staff attack and casts a cantrip."
    },
    {
      "name": "Petrified Ash Staff",
      "desc": "_Melee Weapon Attack:_ +6 to hit, reach 5 ft., one target. _Hit:_ 6 (1d6 + 3) bludgeoning damage, or 7 (1d8 + 3) bludgeoning damage if used with two hands, plus 9 (2d8) necrotic damage."
    },
    {
      "name": "Siphon Life (Recharge 5–6)",
      "desc": "_Ranged Spell Attack:_ +7 to hit, range 60 ft., one creature. _Hit:_ 18 (4d8) necrotic damage. Sirrith regains hit points equal to half the necrotic damage dealt, and gains 1 Defile Charge."
    }
  ],
