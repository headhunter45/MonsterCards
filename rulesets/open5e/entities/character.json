{
  "$schema": "https://schemas.ttrpgwith.me/entity-definition.json",
  "id": "character",
  "name": "Player Character",
  "description": "5e Player Character entity with ability scores, proficiencies, hit points, and inventory.",
  "ruleset_id": "open5e",
  "version": "1.0.0",
  "default_template": "character_sheet",
  "allowed_templates": [
    "character_sheet",
    "character_sheet_alt",
    "spellcasting_sheet",
    "stat_block",
    "character_card",
    "character_list_item"
  ],
  "default_editor": "entity_form",
  "schema": {
    "type": "object",
    "required": ["abilities", "hit_points"],
    "$defs": {
      "abilityScore": {
        "type": ["integer", "object"],
        "description": "Ability score integer or rich ability object with display_name, short_name, value, modifier, proficiency, and saving_throw.",
        "properties": {
          "display_name": {
            "type": "string",
            "description": "Full display name (e.g. 'Strength', 'Dexterity')."
          },
          "short_name": {
            "type": "string",
            "description": "3-letter abbreviation (e.g. 'Str', 'Dex', 'Con', 'Int', 'Wis', 'Cha')."
          },
          "value": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "Base ability score (typically 1 to 30)."
          },
          "modifier": {
            "type": "integer",
            "description": "Calculated ability modifier: floor((value - 10) / 2)."
          },
          "proficiency": {
            "type": "boolean",
            "default": false,
            "description": "Whether the character is proficient in saving throws for this ability."
          },
          "saving_throw": {
            "type": "integer",
            "description": "Calculated saving throw bonus: modifier + (proficiency ? proficiency_bonus : 0)."
          },
          "advantage": {
            "type": ["boolean", "string"],
            "default": false,
            "description": "Advantage flag or conditions for saving throws of this ability."
          }
        }
      },
      "actionEntry": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name or title of the action, trait, or feature."
          },
          "desc": {
            "type": "string",
            "description": "Mechanical description or rule text."
          }
        },
        "additionalProperties": true
      }
    },
    "properties": {
      "class_levels": {
        "type": ["object", "array"],
        "description": "Per-class level progression. Keyed object mapping class slug to class progression details, or array of class progression entries.",
        "additionalProperties": {
          "type": "object",
          "required": ["name", "level"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Class name (e.g. 'Fighter', 'Mage', 'Ranger')."
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "Level in this specific class."
            },
            "subclass": {
              "type": ["string", "null"],
              "description": "Archetype or subclass chosen for this class (only one subclass per class, or null)."
            },
            "description": {
              "type": "string",
              "description": "Optional notes, fighting style, or feature summary for this class progression."
            }
          }
        },
        "items": {
          "type": "object",
          "required": ["name", "level"],
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "level": { "type": "integer", "minimum": 1, "maximum": 20 },
            "subclass": { "type": ["string", "null"] },
            "description": { "type": "string" }
          }
        }
      },
      "race": {
        "type": "string",
        "description": "Character race / species."
      },
      "size": {
        "type": "string",
        "enum": ["tiny", "small", "medium", "large", "huge", "gargantuan"],
        "description": "Creature size category."
      },
      "type": {
        "type": "string",
        "description": "Creature type (e.g. 'Dragon', 'Monstrosity', 'Humanoid', 'Beast', 'Undead')."
      },
      "subtype": {
        "type": "string",
        "description": "Creature subcategory or heritage (e.g. 'Elf', 'Goblinoid', 'Shapechanger')."
      },
      "tag": {
        "type": "string",
        "description": "Optional secondary creature tag or category."
      },
      "background": {
        "type": "string",
        "description": "Character background."
      },
      "alignment": {
        "type": "string",
        "examples": [
          "Lawful Good",
          "Neutral Good",
          "Chaotic Good",
          "Lawful Neutral",
          "True Neutral",
          "Chaotic Neutral",
          "Lawful Evil",
          "Neutral Evil",
          "Chaotic Evil"
        ],
        "description": "Ethical and moral alignment."
      },
      "experience_points": {
        "type": "integer",
        "minimum": 0
      },
      "challenge_rating": {
        "type": "string",
        "description": "Challenge rating display string (e.g. '2 (450 XP)', '1/4')."
      },
      "xp": {
        "type": "integer",
        "description": "Experience points granted for defeating the creature."
      },
      "proficiency_bonus": {
        "type": "integer",
        "description": "Proficiency bonus (+2 to +9)."
      },
      "armor_class": {
        "type": ["integer", "object"],
        "description": "Armor class value or extended property with shield/dex/item modifiers."
      },
      "armor_description": {
        "type": "string",
        "description": "Descriptive armor text following AC (e.g. 'natural armor', 'leather armor', '14 (natural armor), 11 while prone')."
      },
      "shield_bonus": {
        "type": "integer",
        "default": 0,
        "description": "Shield bonus added to AC."
      },
      "nat_armor_bonus": {
        "type": "integer",
        "default": 0,
        "description": "Natural armor bonus."
      },
      "equipped_armor": {
        "type": ["object", "null"],
        "description": "Currently equipped body armor item snapshot or reference. null if unarmored.",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "armor_category": {
            "type": "string",
            "enum": ["light", "medium", "heavy"]
          },
          "ac_base": { "type": "integer" },
          "dex_cap": { "type": ["integer", "null"] },
          "stealth_disadvantage": { "type": "boolean" },
          "strength_requirement": { "type": ["integer", "null"] }
        }
      },
      "equipped_shield": {
        "type": ["object", "null"],
        "description": "Currently equipped shield item snapshot or reference. null if no shield is equipped.",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "ac_bonus": { "type": "integer", "default": 2 },
          "stealth_disadvantage": { "type": "boolean" },
          "strength_requirement": { "type": ["integer", "null"] }
        }
      },
      "speed": {
        "type": ["integer", "string"],
        "description": "Base walking speed in feet."
      },
      "speed_desc": {
        "type": "string",
        "description": "Full human-readable movement speed string (e.g. '30 ft., burrow 10 ft.')."
      },
      "burrow_speed": {
        "type": ["integer", "string"],
        "description": "Burrow speed in feet."
      },
      "climb_speed": {
        "type": ["integer", "string"],
        "description": "Climb speed in feet."
      },
      "fly_speed": {
        "type": ["integer", "string"],
        "description": "Fly speed in feet."
      },
      "swim_speed": {
        "type": ["integer", "string"],
        "description": "Swim speed in feet."
      },
      "hover": {
        "type": "boolean",
        "default": false,
        "description": "Whether the creature can hover while flying."
      },
      "custom_speed": {
        "type": "boolean",
        "default": false
      },
      "hit_points": {
        "type": "object",
        "required": ["current", "max"],
        "properties": {
          "current": { "type": "integer" },
          "max": { "type": "integer" },
          "temp": { "type": "integer", "default": 0 },
          "base": { "type": ["integer", "null"] },
          "bonus": { "type": ["integer", "null"] },
          "override": { "type": ["integer", "null"] },
          "removed": { "type": ["integer", "null"] },
          "formula": {
            "type": "string",
            "description": "Dice expression for HP (e.g. '6d10 + 6')."
          },
          "hit_dice": {
            "type": "string",
            "description": "Hit dice string (e.g. '6d10')."
          },
          "custom_hp": { "type": "boolean", "default": false }
        }
      },
      "attunement": {
        "type": "object",
        "properties": {
          "current": { "type": "integer", "default": 0 },
          "max": { "type": "integer", "default": 3 }
        }
      },
      "abilities": {
        "type": "object",
        "description": "Core 5e ability scores and saving throws keyed by canonical ability name.",
        "required": [
          "strength",
          "dexterity",
          "constitution",
          "intelligence",
          "wisdom",
          "charisma"
        ],
        "properties": {
          "strength": { "$ref": "#/$defs/abilityScore" },
          "dexterity": { "$ref": "#/$defs/abilityScore" },
          "constitution": { "$ref": "#/$defs/abilityScore" },
          "intelligence": { "$ref": "#/$defs/abilityScore" },
          "wisdom": { "$ref": "#/$defs/abilityScore" },
          "charisma": { "$ref": "#/$defs/abilityScore" }
        }
      },
      "player_name": {
        "type": "string",
        "description": "Name of the player controlling this character."
      },
      "subclass": {
        "type": "string",
        "description": "Character archetype or subclass (e.g. Hunter, Champion, Evoker)."
      },
      "inspiration": {
        "type": ["boolean", "integer"],
        "default": false,
        "description": "Heroic inspiration state or count."
      },
      "initiative": {
        "type": ["integer", "object"],
        "description": "Initiative modifier (typically dexterity modifier plus bonuses)."
      },
      "hit_dice": {
        "type": "object",
        "properties": {
          "total": { "type": ["integer", "string"] },
          "current": { "type": ["integer", "string"] },
          "dice": { "type": "string" }
        }
      },
      "death_saves": {
        "type": "object",
        "properties": {
          "successes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "default": 0
          },
          "failures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "default": 0
          },
          "is_stabilized": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "saving_throws": {
        "type": ["array", "object"],
        "description": "Saving throw proficiencies and bonuses."
      },
      "skills": {
        "type": ["array", "object"],
        "description": "Skill proficiencies and bonuses across the 18 standard 5e skills."
      },
      "passive_perception": {
        "type": ["integer", "object"],
        "description": "Passive Wisdom (Perception) score: typically 10 + perception bonus."
      },
      "other_proficiencies_and_languages": {
        "type": "object",
        "properties": {
          "armor": { "type": "array", "items": { "type": "string" } },
          "weapons": { "type": "array", "items": { "type": "string" } },
          "tools": { "type": "array", "items": { "type": "string" } },
          "languages": { "type": "array", "items": { "type": "string" } }
        }
      },
      "attacks": {
        "type": "array",
        "description": "Weapons and spell attacks for the Attacks & Spellcasting section.",
        "items": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "atk_bonus": { "type": ["string", "integer"] },
            "damage": { "type": "string" },
            "damage_type": { "type": "string" },
            "range": { "type": "string" },
            "notes": { "type": "string" }
          }
        }
      },
      "currency": {
        "type": "object",
        "properties": {
          "cp": { "type": "integer", "default": 0 },
          "sp": { "type": "integer", "default": 0 },
          "ep": { "type": "integer", "default": 0 },
          "gp": { "type": "integer", "default": 0 },
          "pp": { "type": "integer", "default": 0 }
        }
      },
      "personality_traits": { "type": ["string", "array"] },
      "ideals": { "type": ["string", "array"] },
      "bonds": { "type": ["string", "array"] },
      "flaws": { "type": ["string", "array"] },
      "features_and_traits": {
        "type": "array",
        "description": "Class, racial, and background features.",
        "items": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "source": { "type": "string" },
            "desc": { "type": "string" }
          }
        }
      },
      "senses": {
        "type": "string",
        "description": "Human-readable summary of senses (e.g. 'darkvision 60 ft., tremorsense 60 ft., passive Perception 11')."
      },
      "blindsight": {
        "type": ["integer", "string"],
        "description": "Blindsight range in feet."
      },
      "blind": {
        "type": "boolean",
        "default": false,
        "description": "Whether blindsight is restricted to blind creatures (blind beyond this radius)."
      },
      "darkvision": {
        "type": ["integer", "string"],
        "description": "Darkvision range in feet."
      },
      "tremorsense": {
        "type": ["integer", "string"],
        "description": "Tremorsense range in feet."
      },
      "truesight": {
        "type": ["integer", "string"],
        "description": "Truesight range in feet."
      },
      "telepathy": {
        "type": ["integer", "string"],
        "description": "Telepathy range in feet."
      },
      "languages": {
        "type": ["array", "string"],
        "description": "Languages spoken or understood by the creature.",
        "items": { "type": ["string", "object"] }
      },
      "understands_but": {
        "type": "string",
        "description": "Condition or limitation on language comprehension (e.g. \"doesn't like to\", \"cannot speak\")."
      },
      "languages_detail": {
        "type": "array",
        "description": "Structured per-language breakdown indicating fluency vs comprehension.",
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "speaks": { "type": "boolean", "default": true }
          }
        }
      },
      "damage_vulnerabilities": {
        "type": "array",
        "description": "Damage types the creature is vulnerable to.",
        "items": { "type": ["string", "object"] }
      },
      "damage_resistances": {
        "type": "array",
        "description": "Damage types the creature resists.",
        "items": { "type": ["string", "object"] }
      },
      "damage_immunities": {
        "type": "array",
        "description": "Damage types the creature is immune to.",
        "items": { "type": ["string", "object"] }
      },
      "condition_immunities": {
        "type": "array",
        "description": "Conditions the creature is immune to.",
        "items": { "type": ["string", "object"] }
      },
      "traits": {
        "type": "array",
        "description": "Special traits and passive monster features.",
        "items": { "$ref": "#/$defs/actionEntry" }
      },
      "actions": {
        "type": "array",
        "description": "Standard combat actions (attacks, breath weapons, spells, multiattack).",
        "items": { "$ref": "#/$defs/actionEntry" }
      },
      "bonus_actions": {
        "type": "array",
        "description": "Bonus actions available to the creature.",
        "items": { "$ref": "#/$defs/actionEntry" }
      },
      "reactions": {
        "type": "array",
        "description": "Reactions available to the creature.",
        "items": { "$ref": "#/$defs/actionEntry" }
      },
      "legendary_actions": {
        "type": ["object", "array"],
        "description": "Legendary action preamble and action options.",
        "properties": {
          "description": { "type": "string" },
          "actions": {
            "type": "array",
            "items": { "$ref": "#/$defs/actionEntry" }
          }
        }
      },
      "mythic_actions": {
        "type": ["object", "array"],
        "description": "Mythic action preamble and action options.",
        "properties": {
          "description": { "type": "string" },
          "actions": {
            "type": "array",
            "items": { "$ref": "#/$defs/actionEntry" }
          }
        }
      },
      "lair_actions": {
        "type": ["object", "array"],
        "description": "Lair action preamble, effects, and usage rules.",
        "properties": {
          "description": { "type": "string" },
          "description_end": { "type": "string" },
          "actions": {
            "type": "array",
            "items": { "$ref": "#/$defs/actionEntry" }
          }
        }
      },
      "regional_effects": {
        "type": ["object", "array"],
        "description": "Regional effects caused by the creature's lair.",
        "properties": {
          "description": { "type": "string" },
          "description_end": { "type": "string" },
          "effects": {
            "type": "array",
            "items": { "$ref": "#/$defs/actionEntry" }
          }
        }
      },
      "is_legendary": { "type": "boolean", "default": false },
      "is_mythic": { "type": "boolean", "default": false },
      "is_lair": { "type": "boolean", "default": false },
      "is_regional": { "type": "boolean", "default": false },
      "character_details": {
        "type": "object",
        "properties": {
          "age": { "type": ["integer", "string"] },
          "height": { "type": "string" },
          "weight": { "type": "string" },
          "eyes": { "type": "string" },
          "skin": { "type": "string" },
          "hair": { "type": "string" },
          "appearance": { "type": "string" },
          "backstory": { "type": "string" },
          "allies_and_organizations": { "type": ["string", "array"] },
          "treasure": { "type": ["string", "array"] },
          "gender": { "type": "string" },
          "faith": { "type": "string" },
          "lifestyle": { "type": "string" },
          "personal_possessions": { "type": "string" },
          "other_holdings": { "type": "string" },
          "enemies": { "type": ["string", "array"] }
        }
      },
      "decorations": {
        "type": "object",
        "properties": {
          "avatar_url": { "type": ["string", "null"] },
          "backdrop_url": { "type": ["string", "null"] },
          "theme_color": { "type": ["string", "null"] }
        }
      },
      "conditions": {
        "type": "array",
        "description": "Active status conditions on the character.",
        "items": { "type": ["string", "object"] }
      },
      "feats": {
        "type": "array",
        "description": "Feats chosen by the character.",
        "items": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "id": { "type": "string" },
            "entity_ref": {
              "type": "string",
              "description": "Optional reference to standalone feat entity (e.g. 'rulesets/open5e/examples/feat/sharpshooter.json' or UUID)."
            },
            "name": { "type": "string" },
            "desc": { "type": "string" },
            "description": { "type": "string" },
            "prerequisite": { "type": "string" }
          }
        }
      },
      "infusions": {
        "type": "object",
        "description": "Artificer infusions known and active.",
        "properties": {
          "known": {
            "type": "array",
            "items": {
              "type": ["string", "object"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "entity_ref": {
                  "type": "string",
                  "description": "Optional reference to standalone infusion entity."
                }
              }
            }
          },
          "active": {
            "type": "array",
            "items": {
              "type": ["string", "object"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "entity_ref": {
                  "type": "string",
                  "description": "Optional reference to standalone infusion entity."
                },
                "target_item_id": {
                  "type": "string",
                  "description": "Inventory item ID to which this infusion is currently applied."
                },
                "target_item_name": { "type": "string" }
              }
            }
          }
        }
      },
      "vehicles": {
        "type": "array",
        "description": "Vehicles owned, operated, or crewed by this character.",
        "items": {
          "type": ["string", "object"],
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "entity_ref": {
              "type": "string",
              "description": "Optional reference to standalone vehicle entity."
            },
            "role": {
              "type": "string",
              "description": "Role on vehicle (e.g. Captain, Helmsman, Gunner, Owner)."
            }
          }
        }
      },
      "spellcasting": {
        "type": "object",
        "properties": {
          "class": { "type": "string" },
          "ability": { "type": "string" },
          "save_dc": { "type": ["integer", "object"] },
          "attack_bonus": { "type": ["integer", "object"] },
          "cantrips": {
            "type": "array",
            "items": { "type": ["string", "object"] }
          },
          "slots": {
            "type": "object",
            "description": "Spell slot counts per spell level 1-9.",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "total": { "type": "integer" },
                "expended": { "type": "integer", "default": 0 }
              }
            }
          },
          "pact_magic": {
            "type": "object",
            "description": "Warlock pact magic slots.",
            "properties": {
              "level": { "type": "integer", "minimum": 1, "maximum": 5 },
              "slots": { "type": "integer" },
              "expended": { "type": "integer", "default": 0 }
            }
          },
          "spells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "id": { "type": "string" },
                "entity_ref": {
                  "type": "string",
                  "description": "Optional reference to standalone spell entity (e.g. 'rulesets/open5e/examples/spell/fireball.json' or UUID)."
                },
                "name": { "type": "string" },
                "level": { "type": "integer", "minimum": 0, "maximum": 9 },
                "prepared": { "type": "boolean", "default": false },
                "desc": { "type": "string" },
                "school": { "type": "string" },
                "casting_time": { "type": "string" },
                "range": { "type": "string" },
                "duration": { "type": "string" },
                "source": { "type": "string" },
                "at_will": { "type": "boolean", "default": false },
                "ritual": { "type": "boolean", "default": false },
                "concentration": { "type": "boolean", "default": false }
              }
            }
          }
        }
      },
      "inventory": {
        "type": "array",
        "description": "List of carried items.",
        "items": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "string" },
            "entity_ref": {
              "type": "string",
              "description": "Optional relative path or identifier of the base item entity."
            },
            "name": { "type": "string" },
            "quantity": { "type": "integer", "default": 1 },
            "weight": { "type": "number", "default": 0 },
            "equipped": { "type": "boolean", "default": false },
            "attuned": { "type": "boolean", "default": false },
            "requires_attunement": { "type": "boolean", "default": false },
            "charges": { "type": "integer" },
            "max_charges": { "type": "integer" },
            "rarity": { "type": "string" },
            "filter_type": { "type": "string" },
            "container_id": { "type": ["string", "integer", "null"] },
            "description": { "type": "string" },
            "cost": { "type": ["number", "string", "object"] },
            "ac_base": { "type": "integer" },
            "dex_cap": { "type": ["integer", "null"] },
            "ac_bonus": { "type": "integer" },
            "grants_modifiers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "target": { "type": "string" },
                  "value": { "type": ["number", "string"] },
                  "type": { "type": "string" },
                  "source": { "type": "string" }
                }
              }
            }
          },
          "additionalProperties": true
        }
      }
    }
  },
  "calculated_properties": {
    "armor_class": {
      "expr": "10 + (equipped_armor ? (equipped_armor.ac_modifier !== undefined ? equipped_armor.ac_modifier : equipped_armor.ac_base - 10) : 0) + (equipped_armor && equipped_armor.dex_cap !== null ? (equipped_armor.dex_cap === 0 ? min(0, abilities.dexterity.modifier) : min(equipped_armor.dex_cap, abilities.dexterity.modifier)) : abilities.dexterity.modifier) + (equipped_shield ? equipped_shield.ac_bonus : 0) + sum(filter(armor_class.modifiers, m => m.active && m.type !== 'armor' && m.type !== 'ability'))",
      "type": "integer",
      "dependencies": [
        "equipped_armor",
        "equipped_shield",
        "abilities.dexterity.modifier",
        "armor_class.modifiers"
      ],
      "description": "5e Armor Class calculation: base 10 + armor modifier (e.g. +1 for leather, +8 for plate) + dexterity modifier (capped by armor; heavy armor caps positive dex to 0 but allows negative penalties) + shield bonus + active external modifiers."
    },
    "proficiency_bonus": {
      "expr": "floor((level - 1) / 4) + 2",
      "type": "integer",
      "dependencies": ["level"],
      "description": "Standard 5e proficiency bonus calculation."
    },
    "ability_modifiers.strength": {
      "expr": "floor((abilities.strength - 10) / 2)",
      "type": "integer",
      "dependencies": ["abilities.strength"]
    },
    "ability_modifiers.dexterity": {
      "expr": "floor((abilities.dexterity - 10) / 2)",
      "type": "integer",
      "dependencies": ["abilities.dexterity"]
    },
    "ability_modifiers.constitution": {
      "expr": "floor((abilities.constitution - 10) / 2)",
      "type": "integer",
      "dependencies": ["abilities.constitution"]
    },
    "ability_modifiers.intelligence": {
      "expr": "floor((abilities.intelligence - 10) / 2)",
      "type": "integer",
      "dependencies": ["abilities.intelligence"]
    },
    "ability_modifiers.wisdom": {
      "expr": "floor((abilities.wisdom - 10) / 2)",
      "type": "integer",
      "dependencies": ["abilities.wisdom"]
    },
    "ability_modifiers.charisma": {
      "expr": "floor((abilities.charisma - 10) / 2)",
      "type": "integer",
      "dependencies": ["abilities.charisma"]
    }
  },
  "default_values": {
    "level": 1,
    "equipped_armor": null,
    "equipped_shield": null,
    "abilities": {
      "strength": 10,
      "dexterity": 10,
      "constitution": 10,
      "intelligence": 10,
      "wisdom": 10,
      "charisma": 10
    },
    "hit_points": {
      "current": 10,
      "max": 10,
      "temp": 0
    },
    "speed": 30,
    "inventory": []
  },
  "ui": {
    "fields": {
      "level": {
        "readonly": true,
        "label": "Level (derived from Class Levels)"
      },
      "race": {},
      "size": {},
      "type": {},
      "subtype": {},
      "challenge_rating": {},
      "class_levels": {
        "widget": "array-of-objects-editor",
        "label": "Class Levels"
      },
      "attacks": {
        "widget": "array-of-objects-editor",
        "label": "Attacks"
      },
      "features_and_traits": {
        "widget": "array-of-objects-editor",
        "label": "Features & Traits"
      },
      "feats": {
        "widget": "array-of-objects-editor",
        "label": "Feats"
      },
      "abilities": {
        "widget": "builtin-object-group",
        "fields": {
          "strength": { "widget": "ability-score-stepper" },
          "dexterity": { "widget": "ability-score-stepper" },
          "constitution": { "widget": "ability-score-stepper" },
          "intelligence": { "widget": "ability-score-stepper" },
          "wisdom": { "widget": "ability-score-stepper" },
          "charisma": { "widget": "ability-score-stepper" }
        }
      },
      "actions": {
        "widget": "action-list-editor",
        "label": "Actions",
        "config": {
          "allowCustomRecharge": true,
          "maxItems": 20
        }
      },
      "traits": {
        "widget": "action-list-editor",
        "label": "Traits & Features"
      },
      "hit_points": { "hidden": false }
    }
  }
}
