    "racialTraits": [
      {
        "definition": {
          "id": 3,
          "definitionKey": "racial-trait:3",
          "entityTypeId": 1960452172,
          "displayOrder": 6,
          "name": "Draconic Ancestry",
          "description": "<p>You have draconic ancestry. Choose one type of dragon from the Draconic Ancestry table. Your breath weapon and damage resistance are determined by the dragon type, as shown in the table.</p>\r\n<h5 id=\"DraconicAncestryTable\" class=\"quick-menu-exclude compendium-hr\">Draconic Ancestry</h5>\r\n<div class=\"table-overflow-wrapper\">\r\n<table class=\"table-compendium table--generic-dice\">\r\n<thead>\r\n<tr>\r\n<th>Dragon</th>\r\n<th>Damage Type</th>\r\n<th>Breath Weapon</th>\r\n</tr>\r\n</thead>\r\n<tbody>\r\n<tr>\r\n<td>Black</td>\r\n<td>Acid</td>\r\n<td>5 by 30 ft. line (Dex. save)</td>\r\n</tr>\r\n<tr>\r\n<td>Blue</td>\r\n<td>Lightning</td>\r\n<td>5 by 30 ft. line (Dex. save)</td>\r\n</tr>\r\n<tr>\r\n<td>Brass</td>\r\n<td>Fire</td>\r\n<td>5 by 30 ft. line (Dex. save)</td>\r\n</tr>\r\n<tr>\r\n<td>Bronze</td>\r\n<td>Lightning</td>\r\n<td>5 by 30 ft. line (Dex. save)</td>\r\n</tr>\r\n<tr>\r\n<td>Copper</td>\r\n<td>Acid</td>\r\n<td>5 by 30 ft. line (Dex. save)</td>\r\n</tr>\r\n<tr>\r\n<td>Gold</td>\r\n<td>Fire</td>\r\n<td>15 ft. cone (Dex. save)</td>\r\n</tr>\r\n<tr>\r\n<td>Green</td>\r\n<td>Poison</td>\r\n<td>15 ft. cone (Con. save)</td>\r\n</tr>\r\n<tr>\r\n<td>Red</td>\r\n<td>Fire</td>\r\n<td>15 ft. cone (Dex. save)</td>\r\n</tr>\r\n<tr>\r\n<td>Silver</td>\r\n<td>Cold</td>\r\n<td>15 ft. cone (Con. save)</td>\r\n</tr>\r\n<tr>\r\n<td>White</td>\r\n<td>Cold</td>\r\n<td>15 ft. cone (Con. save)</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n</div>",
          "snippet": "You gain a breath weapon and damage resistance with your chosen dragon type.",
