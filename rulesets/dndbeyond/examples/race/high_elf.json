      {
        "definition": {
          "id": 85,
          "definitionKey": "racial-trait:85",
          "entityTypeId": 1960452172,
          "displayOrder": 10,
          "name": "Languages",
          "description": "<p>You can speak, read, and write Common and Elvish. Elvish is fluid, with subtle intonations and intricate grammar. Elven literature is rich and varied, and their songs and poems are famous among other races. Many bards learn their language so they can add Elvish ballads to their repertoires.</p>",
