  "calculated_properties": {
    "total_level": {
      "expr": "sum(classes.map(c => c.level))",
      "type": "integer",
      "dependencies": [
        "classes"
      ],
      "description": "Total character level calculated as the sum of all class levels."
    },
    "proficiency_bonus": {
      "expr": "floor((total_level - 1) / 4) + 2",
      "type": "integer",
      "dependencies": [
        "classes"
      ],
      "description": "Standard 5e proficiency bonus based on total character level."
    },
    "max_hit_points": {
      "expr": "overrideHitPoints != null ? overrideHitPoints : (baseHitPoints + (bonusHitPoints || 0))",
      "type": "integer",
      "dependencies": [
        "baseHitPoints",
        "bonusHitPoints",
        "overrideHitPoints"
      ],
      "description": "Calculated maximum hit points factoring in base, bonus, and override values."
    },
    "current_hit_points": {
      "expr": "max(0, max_hit_points - removedHitPoints)",
      "type": "integer",
      "dependencies": [
        "baseHitPoints",
        "bonusHitPoints",
        "overrideHitPoints",
        "removedHitPoints"
      ],
      "description": "Current hit points remaining after sustained damage."
    }
  },
